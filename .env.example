# Salin ke ".env" lalu isi nilainya. Berkas ".env" tidak pernah masuk Git.

# Kunci enkripsi Laravel. Buat dengan:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# MySQL (nama host "db" sudah diatur di docker-compose.yml)
DB_DATABASE=pelacak_magang
DB_USERNAME=pelacak
DB_PASSWORD=ganti-dengan-sandi-sendiri
DB_ROOT_PASSWORD=ganti-dengan-sandi-root-sendiri

# Port di laptop (bukan di dalam container)
BACKEND_PORT=8000
FRONTEND_PORT=8080